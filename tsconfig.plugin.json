{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@mindroom/client-sdk/*": ["./src/client-sdk/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "scheduler": ["./node_modules/@types/scheduler"],
      "scheduler/*": ["./node_modules/@types/scheduler/*"],
      "matrix-js-sdk": ["./node_modules/matrix-js-sdk"],
      "matrix-js-sdk/*": ["./node_modules/matrix-js-sdk/*"],
      "jotai": ["./node_modules/jotai"],
      "jotai/*": ["./node_modules/jotai/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "@tanstack/react-query/*": ["./node_modules/@tanstack/react-query/*"],
      "@tanstack/query-core": ["./node_modules/@tanstack/query-core"],
      "@tanstack/query-core/*": ["./node_modules/@tanstack/query-core/*"],
      "react-router": ["./node_modules/react-router"],
      "react-router/*": ["./node_modules/react-router/*"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      "react-router-dom/*": ["./node_modules/react-router-dom/*"],
      "@remix-run/router": ["./node_modules/@remix-run/router"],
      "@remix-run/router/*": ["./node_modules/@remix-run/router/*"],
      "i18next": ["./node_modules/i18next"],
      "i18next/*": ["./node_modules/i18next/*"],
      "react-i18next": ["./node_modules/react-i18next"],
      "react-i18next/*": ["./node_modules/react-i18next/*"],
      "folds": ["./node_modules/folds"],
      "folds/*": ["./node_modules/folds/*"],
      "focus-trap": ["./node_modules/focus-trap"],
      "focus-trap/*": ["./node_modules/focus-trap/*"],
      "focus-trap-react": ["./node_modules/focus-trap-react"],
      "focus-trap-react/*": ["./node_modules/focus-trap-react/*"],
      "dayjs": ["./node_modules/dayjs"],
      "dayjs/*": ["./node_modules/dayjs/*"],
      "react-aria": ["./node_modules/react-aria"],
      "react-aria/*": ["./node_modules/react-aria/*"],
      "vitest": ["./node_modules/vitest"],
      "vitest/*": ["./node_modules/vitest/*"]
    }
  },
  "files": [
    "./src/types/browser-encrypt-attachment.d.ts",
    "./src/types/cache-probe-window.d.ts",
    "./src/types/novnc-core.d.ts",
    "./src/types/novnc.d.ts",
    "./src/types/react-act-environment.d.ts",
    "./node_modules/vite/client.d.ts"
  ],
  "include": []
}
