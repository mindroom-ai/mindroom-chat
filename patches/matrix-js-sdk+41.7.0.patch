+type ThreadResetTokenResponse = Awaited<ReturnType<MatrixClient["createMessagesRequest"]>>;
+
+// A limited sync gives every thread in a room the same tokens. Share their conversion while it is in flight instead
+// of issuing two identical /messages requests for every materialized thread.
+const threadResetTokenConversionRequests = new WeakMap<
+    MatrixClient,
+    Map<string, Promise<ThreadResetTokenResponse>>
+>();
+
+const convertThreadResetToken = (
+    client: MatrixClient,
+    roomId: string,
+    token: string,
+    direction: Direction,
+): Promise<ThreadResetTokenResponse> => {
+    let requests = threadResetTokenConversionRequests.get(client);
+    if (!requests) {
+        requests = new Map();
+        threadResetTokenConversionRequests.set(client, requests);
+    }
+
+    const key = JSON.stringify([roomId, token, direction]);
+    const existingRequest = requests.get(key);
+    if (existingRequest) return existingRequest;
+
+    const request = client.createMessagesRequest(roomId, token, 1, direction);
+    requests.set(key, request);
+
+    const cleanup = (): void => {
+        if (requests.get(key) !== request) return;
+        requests.delete(key);
+        if (requests.size === 0) threadResetTokenConversionRequests.delete(client);
+    };
+    void request.then(cleanup, cleanup);
+
+    return request;
+};
