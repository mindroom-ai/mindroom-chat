#!/usr/bin/env bash
# mindroom-client upstream-overlap pre-push hook
#
# No commit with upstream overlap leaves this clone (AGENTS.md, "No upstream code, in any commit").
# For each pushed ref, every commit the remote does not have yet (reachable from the pushed tip,
# not from the remote's old tip of that ref or from its main branch) is checked: each text file the
# commit adds or modifies, as that commit has it, by the copy of scripts/upstream-overlap/check.py
# beside this hook, against the upstream clone recorded beside it. Any finding, a missing corpus or
# a checker that fails blocks the push.
#
# scripts/git-hooks/install.sh puts this file, the checker and the corpus path in the clone's hooks
# directory (`just install-hooks <upstream clone>`); install again after changing either file. A
# pre-push hook that was there before is kept as pre-push.local and runs first, with the same input.
#
# UPSTREAM_OVERLAP_BYPASS='<reason>' skips the check, for the coordinator's emergencies only: the
# hook then prints a banner and appends the push to upstream-overlap-bypass.log in the git directory.
set -euo pipefail

hooks=$(cd "$(dirname "$0")" && pwd)
input=$(mktemp)
trap 'rm -f "$input"' EXIT
cat >"$input"

if [ -x "$hooks/pre-push.local" ]; then
  "$hooks/pre-push.local" "$@" <"$input"
fi

if [ -n "${UPSTREAM_OVERLAP_BYPASS:-}" ]; then
  log="$(git rev-parse --path-format=absolute --git-common-dir)/upstream-overlap-bypass.log"
  remote=$(printf '%s' "$2" | sed -E 's#://[^/@]*@#://#') # never log credentials in the URL
  entry="$(date -u +%Y-%m-%dT%H:%M:%SZ)	$PWD	$remote	$(printf '%s' "$UPSTREAM_OVERLAP_BYPASS" | tr '\t\n' '  ')	$(tr '\n' ';' <"$input")"
  printf '%s\n' "$entry" >>"$log"
  {
    echo '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
    echo "!!! UPSTREAM OVERLAP CHECK BYPASSED: $UPSTREAM_OVERLAP_BYPASS"
    echo "!!! Pushing to $remote without checking these refs; logged in $log"
    sed 's/^/!!!   /' "$input"
    echo '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
  } >&2
  exit 0
fi

blocked() {
  echo "pre-push: push blocked. $1" >&2
  shift
  printf '%s\n' "$@" >&2
  exit 1
}

corpus=$(cat "$hooks/upstream-overlap/corpus" 2>/dev/null) ||
  blocked "No corpus recorded beside the hook: run scripts/git-hooks/install.sh --corpus <upstream clone>."
python3 "$hooks/upstream-overlap/check.py" --corpus "$corpus" --pre-push "$2" <"$input" ||
  blocked "The upstream overlap check reported findings or could not run (exit $?); see above." \
    'Each commit would reach the remote, so a later commit that deletes the lines does not help:' \
    'rewrite the listed commits without them (for example: reset to the base, commit again).'
