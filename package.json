{
  "name": "mindroom-client",
  "version": "0.1.0",
  "private": true,
  "description": "Apache-2.0 MindRoom client on matrix-js-sdk with Rust crypto (clean-room implementation)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:ios": "npm run build && node scripts/ios-client-config.mjs dist/config.json",
    "appstore:preflight": "node scripts/appstore-preflight.mjs",
    "appstore:release:preflight": "node scripts/appstore-release-preflight.mjs ios/App/fastlane/screenshots/en-US",
    "appstore:fixture": "scripts/appstore-fixture-up.sh",
    "appstore:screenshots": "scripts/appstore-screenshots.sh",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck-tests": "tsc --noEmit -p .",
    "test": "vitest run",
    "lint": "eslint --ext .ts,.tsx,.js,.mjs,.cjs src e2e scripts vite.config.js vitest.config.ts .eslintrc.cjs",
    "typecheck-all": "node scripts/typecheck-all.mjs",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@basnijholt/particular-drift": "0.2.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.1",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/inter": "4.5.14",
    "@novnc/novnc": "1.7.0",
    "@ricky0123/vad-web": "0.0.31",
    "@tabler/icons-react": "3.40.0",
    "@tanstack/react-query": "5.24.1",
    "@tanstack/react-virtual": "3.14.5",
    "@vanilla-extract/css": "1.9.3",
    "@vanilla-extract/recipes": "0.3.0",
    "await-to-js": "3.0.0",
    "blurhash": "2.0.5",
    "browser-encrypt-attachment": "0.3.0",
    "chroma-js": "3.1.2",
    "classnames": "2.3.2",
    "dayjs": "1.11.10",
    "domhandler": "5.0.3",
    "emojibase": "18.0.0",
    "emojibase-data": "18.0.0",
    "file-saver": "2.0.5",
    "focus-trap-react": "10.0.2",
    "folds": "2.7.1",
    "fuse.js": "7.3.0",
    "html-dom-parser": "4.0.0",
    "html-react-parser": "4.2.0",
    "i18next": "23.12.2",
    "idb": "7.1.1",
    "immer": "9.0.16",
    "is-hotkey": "0.2.0",
    "jotai": "2.6.0",
    "katex": "0.16.44",
    "linkify-react": "4.3.2",
    "linkifyjs": "4.3.2",
    "livekit-client": "2.23.0",
    "markdown-it": "14.3.3",
    "matrix-js-sdk": "41.7.0",
    "onnxruntime-web": "1.31.1",
    "prismjs": "1.30.0",
    "react": "18.2.0",
    "react-aria": "3.53.1",
    "react-dom": "18.2.0",
    "react-error-boundary": "4.0.13",
    "react-i18next": "15.0.0",
    "react-range": "1.10.0",
    "react-router-dom": "6.30.3",
    "sanitize-html": "2.17.6",
    "slate": "0.123.0",
    "slate-dom": "0.123.0",
    "slate-history": "0.113.1",
    "slate-react": "0.123.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0",
    "yaml": "1.10.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "14.3.1",
    "@types/chroma-js": "^3.1.3",
    "@types/eslint": "^8.56.12",
    "@types/file-saver": "^2.0.7",
    "@types/is-hotkey": "^0.1.10",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.2.0",
    "@types/mime-types": "2.1.4",
    "@types/node": "^22.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "18.2.39",
    "@types/react-dom": "18.2.17",
    "@types/react-test-renderer": "^18.3.1",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vanilla-extract/vite-plugin": "3.7.1",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.19.12",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "22.1.0",
    "mime-types": "2.1.35",
    "patch-package": "8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.4.2",
    "vite": "5.4.21",
    "vite-plugin-pwa": "0.21.2",
    "vite-plugin-static-copy": "2.3.2",
    "vitest": "2.1.8",
    "workbox-build": "7.3.0",
    "workbox-window": "7.3.0"
  },
  "overrides": {
    "scheduler": "0.23.2",
    "@tanstack/virtual-core": "3.17.3",
    "folds": {
      "react": "$react",
      "react-dom": "$react-dom",
      "classnames": "$classnames",
      "@vanilla-extract/css": "$@vanilla-extract/css",
      "@vanilla-extract/recipes": "$@vanilla-extract/recipes"
    },
    "@vanilla-extract/vite-plugin": {
      "vite": "$vite"
    }
  }
}
