{
  "name": "mindroom-client",
  "version": "0.1.0",
  "private": true,
  "description": "Apache-2.0 MindRoom client on matrix-js-sdk with Rust crypto",
  "license": "Apache-2.0",
  "type": "module",
  "main": "build/electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "autoRelease": true,
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:ios": "scripts/build.sh && node scripts/ios-client-config.mjs dist/config.json",
    "appstore:preflight": "node scripts/appstore-preflight.mjs",
    "appstore:release:preflight": "node scripts/appstore-release-preflight.mjs ios/App/fastlane/screenshots/en-US",
    "appstore:fixture": "scripts/appstore-fixture-up.sh",
    "appstore:screenshots": "scripts/appstore-screenshots.sh",
    "typecheck": "tsc --noEmit -p config/tsconfig.app.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx,js,mjs,cjs}\" \"e2e/**/*.{ts,tsx,js,mjs,cjs}\" \"scripts/**/*.{ts,tsx,js,mjs,cjs}\" \"electron/**/*.{ts,tsx,js,mjs,cjs}\" vite.config.js vitest.config.ts eslint.config.mjs eslint.config.plugin.mjs playwright.electron.config.ts",
    "postinstall": "patch-package --error-on-fail",
    "build:desktop": "npm run build:ios && node electron/build.mjs",
    "desktop": "electron .",
    "e2e:desktop": "playwright test -c playwright.electron.config.ts"
  },
  "dependencies": {
    "@basnijholt/particular-drift": "0.2.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/inter": "4.5.14",
    "@novnc/novnc": "1.7.0",
    "@ricky0123/vad-web": "0.0.31",
    "@tabler/icons-react": "3.52.0",
    "@tanstack/react-query": "5.108.1",
    "@tanstack/react-virtual": "3.14.26",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.3.0",
    "await-to-js": "3.0.0",
    "blurhash": "2.0.5",
    "browser-encrypt-attachment": "0.3.0",
    "chart.js": "4.6.1",
    "chroma-js": "3.3.0",
    "classnames": "2.5.1",
    "d3": "7.9.2",
    "dayjs": "1.11.23",
    "domhandler": "5.0.3",
    "electron-updater": "6.8.11",
    "emojibase": "18.0.0",
    "emojibase-data": "18.0.0",
    "file-saver": "2.0.5",
    "focus-trap-react": "11.0.6",
    "folds": "2.7.3",
    "fuse.js": "7.5.0",
    "heif-js": "0.1.0",
    "html-dom-parser": "5.0.13",
    "html-react-parser": "5.2.3",
    "i18next": "27.2.6",
    "idb": "7.1.1",
    "is-hotkey": "0.2.1",
    "jotai": "2.6.0",
    "katex": "0.19.1",
    "linkify-react": "4.4.0",
    "linkifyjs": "4.4.0",
    "livekit-client": "2.24.1",
    "markdown-it": "14.3.3",
    "matrix-js-sdk": "45.1.0",
    "mermaid": "12.3.0",
    "onnxruntime-web": "1.31.1",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "4.0.13",
    "react-i18next": "18.0.3",
    "react-range": "1.10.0",
    "react-router-dom": "7.18.6",
    "sanitize-html": "2.18.2",
    "slate": "0.147.4",
    "slate-dom": "0.147.3",
    "slate-history": "0.144.0",
    "slate-react": "0.147.6",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/chroma-js": "^3.1.3",
    "@types/file-saver": "^2.0.7",
    "@types/is-hotkey": "^0.1.10",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.2.0",
    "@types/mime-types": "2.1.4",
    "@types/node": "^22.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/scheduler": "0.28.0",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.14.0",
    "jsdom": "22.1.0",
    "mime-types": "2.1.35",
    "patch-package": "8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.1",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.12",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "scheduler": "0.28.0",
    "@tanstack/virtual-core": "3.17.3",
    "mermaid": {
      "katex": "$katex"
    },
    "folds": {
      "react": "$react",
      "react-dom": "$react-dom",
      "classnames": "$classnames",
      "@vanilla-extract/css": "$@vanilla-extract/css",
      "@vanilla-extract/recipes": "$@vanilla-extract/recipes"
    },
    "@vanilla-extract/vite-plugin": {
      "vite": "$vite",
      "vite-node": "5.3.0"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "es5",
    "semi": true,
    "tabWidth": 2
  }
}
