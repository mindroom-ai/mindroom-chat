{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "../src",
    "../e2e",
    "../electron",
    "../scripts/**/*.test.ts",
    "../vite.config.js",
    "../vitest.config.ts",
    "../playwright.config.ts",
    "../playwright.electron.config.ts"
  ]
}
