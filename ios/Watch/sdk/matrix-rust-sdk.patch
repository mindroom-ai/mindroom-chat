+/// A request the SDK hands to an [`HttpTransport`].
+#[derive(uniffi::Record)]
+pub struct HttpTransportRequest {
+    pub method: String,
+    /// The absolute URL.
+    pub url: String,
+    pub headers: HashMap<String, String>,
+    /// Empty when the request has no body.
+    pub body: Vec<u8>,
+}
+
+/// What an [`HttpTransport`] made of a request.
+#[derive(uniffi::Enum)]
+pub enum HttpTransportResult {
+    Response { status: u16, headers: HashMap<String, String>, body: Vec<u8> },
+    /// The request did not reach the server, or no response came back.
+    Failure { message: String },
+}
+
+/// Sends the SDK's requests for it. watchOS allows an app no sockets, which
+/// the SDK's own HTTP client needs (Apple TN3135), so there the app sends them
+/// with URLSession.
+#[matrix_sdk_ffi_macros::export(callback_interface)]
+#[async_trait::async_trait]
+pub trait HttpTransport: Send + Sync {
+    async fn send(&self, request: HttpTransportRequest) -> HttpTransportResult;
+}
+
+struct HttpTransportWrap(Arc<dyn HttpTransport>);
+
+impl std::fmt::Debug for HttpTransportWrap {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("HttpTransport")
+    }
+}
+
+#[async_trait::async_trait]
+impl matrix_sdk::HttpTransport for HttpTransportWrap {
+    async fn send(
+        &self,
+        request: matrix_sdk::HttpTransportRequest,
+    ) -> Result<matrix_sdk::HttpTransportResponse, String> {
+        let request = HttpTransportRequest {
+            method: request.method,
+            url: request.url,
+            headers: request.headers.into_iter().collect(),
+            body: request.body,
+        };
+        match self.0.send(request).await {
+            HttpTransportResult::Response { status, headers, body } => {
+                Ok(matrix_sdk::HttpTransportResponse {
+                    status,
+                    headers: headers.into_iter().collect(),
+                    body,
+                })
+            }
+            HttpTransportResult::Failure { message } => Err(message),
+        }
+    }
+}
