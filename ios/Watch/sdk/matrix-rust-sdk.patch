+    pub async fn load_or_fetch_event_json_with_relations(
+        &self,
+        event_id: String,
+    ) -> Result<Vec<String>, ClientError> {
+        let event_id = EventId::parse(event_id)?;
+        let event = self.inner.load_or_fetch_event(&event_id, None).await?;
+        let mut options = matrix_sdk::room::RelationsOptions {
+            recurse: true,
+            limit: Some(matrix_sdk::ruma::uint!(256)),
+            ..Default::default()
+        };
+        let mut events = vec![event];
+        loop {
+            let relations = self.inner.relations(event_id.clone(), options.clone()).await?;
+            events.extend(relations.chunk);
+            match relations.next_batch_token {
+                Some(token) => options.from = Some(token),
+                None => break,
+            }
+        }
+        Ok(events.into_iter().map(|event| event.kind.into_raw().json().get().to_owned()).collect())
+    }
