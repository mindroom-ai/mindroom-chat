        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু আর্গুমেন্ট সংক্ষিপ্ত। সবগুলো দেখতে iPhone-এ থ্রেডটি খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
